# Required for live AI analysis (at least one LLM provider key)
GEMINI_API_KEY="your-gemini-api-key"
GROQ_API_KEY="your-groq-api-key"

# Optional: live TinySearch / TinyFetch / TinyAgent web scraping
TINYFISH_API_KEY="your-tinyfish-api-key"

# Recommended in production: persistent cryptographic salt for visitor IP hashing
RATE_LIMIT_SALT="replace-with-random-32-byte-secret"
